# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom OpenAI Base URL (for proxy or alternative endpoints)
OPENAI_BASE_URL=https://api.openai.com/v1

# Server Configuration (Optional)
HOST=0.0.0.0
PORT=8000

# Whisper Model Configuration (Optional)
# Options: tiny, base, small, medium, large
WHISPER_MODEL_SIZE=base

# Local upload size limit in MB (optional; Docker Compose passes this through)
UPLOAD_MAX_MB=200

# Max height for the "keep original video" download (optional)
# Lower it to save bandwidth/disk, raise it for higher quality source files
VIDEO_MAX_HEIGHT=720

# Douyin creator page (douyin.com/user/...) transcription (optional)
# Paste the raw Cookie string from a logged-in browser to raise the success
# rate of creator page parsing and per-video downloads; anonymous requests
# are often limited to the first page of videos by Douyin's risk control.
# DOUYIN_COOKIE=ttwid=...; msToken=...; sessionid=...

# Cap how many of a creator's videos are transcribed per run (optional).
# Useful for testing or sampling a creator with 1000+ videos. Default: no limit.
# DOUYIN_MAX_VIDEOS=10

# Hard-subtitle OCR (optional). Burned-in subtitles are the creator's own text,
# so OCR beats Whisper for fast-paced content (fewer homophone mistakes).
# Enabled by default when rapidocr-onnxruntime is installed; set to 0/off to
# disable and fall back to pure audio transcription.
# SUBTITLE_OCR=1
